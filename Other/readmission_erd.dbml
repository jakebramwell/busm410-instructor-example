// 30-day readmission analysis: bigquery-public-data.cms_synthetic_patient_data_omop

Table location {
  location_id integer [pk]
  state varchar [note: 'Patient home state']
}

Table person {
  person_id integer [pk]
  location_id integer [note: 'Home location']
  year_of_birth integer
}

Table condition_occurrence {
  condition_occurrence_id integer [pk, note: 'One diagnosis row']
  person_id integer
  visit_occurrence_id integer [note: 'Groups rows into one stay']
  condition_type_concept_id integer [note: 'Inpatient vs. outpatient claim']
  condition_start_date date [note: 'Claim start date; admission proxy']
  condition_end_date date [note: 'Claim end date; discharge proxy']
}

Table concept {
  concept_id integer [pk]
  concept_name varchar
}

Table death {
  person_id integer [pk]
  death_date date
}

Ref: person.location_id > location.location_id
Ref: condition_occurrence.person_id > person.person_id
Ref: condition_occurrence.condition_type_concept_id > concept.concept_id
Ref: death.person_id - person.person_id

// The cost table is omitted: the project audit found no inpatient payments loaded there.
// See audit_log.md entry 13. ERD_problem.pdf preserves the earlier diagram and is outdated.
